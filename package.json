  },
  "scripts": {
    "dev": "tauri dev",
    "ui:dev": "vite",
    "build": "vite build",
    "dist": "tauri build",
    "lint": "oxlint ui tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none \"tests/**/*.test.ts\"",
    "test:e2e": "tauri build --debug --no-bundle -- --target-dir ../target/e2e && node --test --test-isolation=none \"tests/e2e/*.e2e.ts\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
