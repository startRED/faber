{
  "name": "faber",
  "productName": "Faber",
  "version": "0.0.2",
  "description": "One app for everything AI can do.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "author": {
    "name": "startRED",
    "email": "pzza.net@gmail.com"
  },
  "homepage": "https://github.com/startRED/faber",
  "repository": "github:startRED/faber",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && electron .",
    "lint": "oxlint src tests",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-isolation=none \"tests/**/*.test.ts\"",
    "test:watch": "node --test --test-isolation=none --watch \"tests/**/*.test.ts\"",
    "dist": "npm run build && electron-builder --publish never",
    "release": "electron-builder --publish always",
    "test:e2e": "npm run build && node --test --test-isolation=none \"tests/e2e/*.e2e.ts\""
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "oxlint": "1.85.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
