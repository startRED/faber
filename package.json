    "@tauri-apps/api": "2.12.2",
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.0",
    "oxlint": "1.87.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
